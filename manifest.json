{
  "manifest_version": 3,
  "name": "ChatAi Memo",
  "description": "本地保存 AI 对话，并可导出为 Markdown 文档。",
  "version": "1.2.0",
  "action": {
    "default_title": "ChatAi Memo",
    "default_icon": {
      "16": "src/assets/icons/chatai-memo-16.png",
      "32": "src/assets/icons/chatai-memo-32.png",
      "48": "src/assets/icons/chatai-memo-48.png",
      "128": "src/assets/icons/chatai-memo-128.png"
    }
  },
  "icons": {
    "16": "src/assets/icons/chatai-memo-16.png",
    "32": "src/assets/icons/chatai-memo-32.png",
    "48": "src/assets/icons/chatai-memo-48.png",
    "128": "src/assets/icons/chatai-memo-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://www.deepseek.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://claude.ai/*",
    "https://claude.com/*",
    "https://www.doubao.com/*",
    "https://doubao.com/*",
    "https://chat.qwen.ai/*",
    "https://qwen.ai/*",
    "https://www.qwen.ai/*",
    "https://www.qianwen.com/*",
    "https://qianwen.com/*",
    "https://yiyan.baidu.com/*",
    "https://chatglm.cn/*",
    "https://www.chatglm.cn/*",
    "https://chat.minimax.io/*",
    "https://www.minimax.io/*",
    "https://minimax.io/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/assets/icons/chatai-memo-48.png"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://claude.ai/*",
        "https://claude.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://chat.qwen.ai/*",
        "https://qwen.ai/*",
        "https://www.qwen.ai/*",
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "https://yiyan.baidu.com/*",
        "https://chatglm.cn/*",
        "https://www.chatglm.cn/*",
        "https://chat.minimax.io/*",
        "https://www.minimax.io/*",
        "https://minimax.io/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "src/shared/conversation-utils.js",
        "src/content/common.js",
        "src/content/chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": [
        "src/shared/conversation-utils.js",
        "src/content/common.js",
        "src/content/gemini.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://claude.ai/*",
        "https://claude.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://chat.qwen.ai/*",
        "https://qwen.ai/*",
        "https://www.qwen.ai/*",
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "https://yiyan.baidu.com/*",
        "https://chatglm.cn/*",
        "https://www.chatglm.cn/*",
        "https://chat.minimax.io/*",
        "https://www.minimax.io/*",
        "https://minimax.io/*"
      ],
      "js": [
        "src/shared/conversation-utils.js",
        "src/content/common.js",
        "src/content/generic.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
